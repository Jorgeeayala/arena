{
  "manifest_version": 3,
  "name": "Ekuatia Login",
  "version": "1.1",
  "description": "Login automático con buscador de clientes + puente desde la app Control Clientes",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["https://marangatu.set.gov.py/*"],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "*://localhost/*",
      "https://*.e2b.app/*"
    ]
  },
  "action": {
    "default_popup": "popup.html"
  }
}
